rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isMember(groupId){return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));}
  match /users/{uid}{allow read,write:if signedIn() && request.auth.uid==uid;match /groupMemberships/{groupId}{allow read:if signedIn() && request.auth.uid==uid;allow write:false;}}
  match /groups/{groupId}{allow read:if isMember(groupId);allow write:false;match /{subcollection}/{documentId}{allow read:if isMember(groupId);allow write:false;}match /{subcollection}/{documentId}/{nested=**}{allow read:if isMember(groupId);allow write:false;}}
  match /{document=**}{allow read,write:false;}
 }
}
